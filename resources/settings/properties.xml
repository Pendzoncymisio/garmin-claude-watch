<?xml version="1.0" encoding="utf-8"?>
<properties>
    <!-- Ships enabled: a real watch cannot reach the dev bridge at all, because
         device HTTPS rules are enforced in firmware and reject a privately
         signed certificate. Demo mode shows invented figures so a fresh install
         has something to look at. The views label it, so it cannot be mistaken
         for real data. Turn off once the bridge has a publicly trusted cert. -->
    <property id="DemoMode" type="boolean">true</property>

    <!-- Deliberately empty. This is a per-install value and belongs in the app
         settings on the device, not in the repository — a default here would
         publish whatever host the author happens to run the bridge on.
         No trailing slash; the client appends /usage. Must be https:// —
         Connect IQ rejects http with SECURE_CONNECTION_REQUIRED (-1001), in the
         simulator as well as on the watch. -->
    <property id="ServerUrl" type="string"></property>

    <!-- Cloudflare Access service token. Empty by default and empty in the
         repository, always: these are credentials and this repository is public.
         Leave both blank for a LAN bridge with no Access in front of it.

         They are sent as a single Authorization header holding both values as
         JSON, which is the form Access reads when the application sets
         read_service_tokens_from_header. One header rather than the usual pair
         of CF-Access-Client-* headers is deliberate — Connect IQ's custom header
         support is the least reliable part of makeWebRequest, so this asks the
         least of it. -->
    <property id="AccessClientId" type="string"></property>
    <property id="AccessClientSecret" type="string"></property>
</properties>
